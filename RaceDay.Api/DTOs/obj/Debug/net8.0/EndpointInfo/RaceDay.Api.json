  "components": {
    "schemas": {
      "CategoryRequest": {
        "required": [
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 80,
            "minLength": 1,
            "type": "string"
          },
          "distanceKm": {
            "maximum": 1000,
            "minimum": 0.1,
            "type": "number",
            "format": "double",
            "nullable": true
          },
          "maxParticipants": {
            "maximum": 100000,
            "minimum": 1,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "minimumAge": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "maximumAge": {
            "maximum": 120,
            "minimum": 0,
            "type": "integer",
            "format": "int32",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "EnrolmentRequest": {
        "type": "object",
        "properties": {
          "categoryId": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "EventRequest": {
        "required": [
          "description",
          "eventType",
          "location",
          "name"
        ],
        "type": "object",
        "properties": {
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "type": "string"
          },
          "description": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "eventDate": {
            "type": "string",
            "format": "date-time"
          },
          "location": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "distanceKm": {
            "maximum": 1000,
            "minimum": 0.1,
            "type": "number",
            "format": "double"
          },
          "eventType": {
            "minLength": 1,
            "pattern": "^(Run|Walk|Cycle)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "LoginRequest": {
        "required": [
          "email",
          "password"
        ],
        "type": "object",
        "properties": {
          "email": {
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 1,
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "nullable": true
          },
          "title": {
            "type": "string",
            "nullable": true
          },
          "status": {
            "type": "integer",
            "format": "int32",
            "nullable": true
          },
          "detail": {
            "type": "string",
            "nullable": true
          },
          "instance": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": { }
      },
      "RegisterRequest": {
        "required": [
          "email",
          "firstName",
          "lastName",
          "password",
          "role"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "email": {
            "maxLength": 254,
            "minLength": 1,
            "type": "string",
            "format": "email"
          },
          "password": {
            "minLength": 8,
            "type": "string"
          },
          "role": {
            "minLength": 1,
            "type": "string"
          },
          "phone": {
            "maxLength": 30,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ResultRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "finishTime": {
            "type": "string",
            "format": "date-span"
          },
          "position": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "minLength": 1,
            "pattern": "^(Finished|DidNotFinish|Disqualified)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "ResultUpdateRequest": {
        "required": [
          "status"
        ],
        "type": "object",
        "properties": {
          "finishTime": {
            "type": "string",
            "format": "date-span"
          },
          "position": {
            "maximum": 2147483647,
            "minimum": 1,
            "type": "integer",
            "format": "int32"
          },
          "status": {
            "minLength": 1,
            "pattern": "^(Finished|DidNotFinish|Disqualified)$",
            "type": "string"
          }
        },
        "additionalProperties": false
      },
      "UpdateProfileRequest": {
        "required": [
          "firstName",
          "lastName"
        ],
        "type": "object",
        "properties": {
          "firstName": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "lastName": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "phone": {
            "maxLength": 30,
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
